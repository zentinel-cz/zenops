# ==========================================================
# Pracovní záznamy - Konfigurace prostředí
# Zkopírujte tento soubor jako .env a doplňte hodnoty
# ==========================================================

# PostgreSQL databáze
PGDATABASE=pracovni_zaznamy
PGUSER=postgres
PGPASSWORD=bezpecne_heslo_db          # ZMĚŇTE V PRODUKCI!

# Aplikace
SESSION_SECRET=zmena_tohoto_tajneho_klic_v_produkci_alespon_32_znaku   # ZMĚŇTE V PRODUKCI!
APP_PORT=3000                          # Port na kterém bude aplikace dostupná
LOG_LEVEL=info                         # info | warn | error | debug

# Seed (vytvoření prvního admina)
ADMIN_PASSWORD=admin123               # Heslo pro admin účet (změňte po prvním přihlášení!)

# Výpočtový NODE_ENV
NODE_ENV=production
