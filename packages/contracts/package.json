{
  "name": "@zenops/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./time": {
      "types": "./src/time.ts",
      "import": "./dist/time.js"
